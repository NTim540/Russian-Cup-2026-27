{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/maintenance-november.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "russian-cup-2627.vercel.app"
        }
      ],
      "destination": "https://tournamentu16.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "russian-cup-2627.vercel.app"
        }
      ],
      "destination": "https://tournamentu16.ru/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
