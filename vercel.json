{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/base-source",
      "destination": "/index.html"
    },
    {
      "source": "/public-api/:resource/:route*",
      "destination": "/api/public-data?resource=:resource&route=:route*"
    }
  ],
  "redirects": [
    {
      "source": "/maintenance-november",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "russian-cup-2627.vercel.app"
        }
      ],
      "destination": "https://tournamentu16.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "russian-cup-2627.vercel.app"
        }
      ],
      "destination": "https://tournamentu16.ru/:path*",
      "permanent": true
    }
  ]
}
